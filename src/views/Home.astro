---
import Base from '../layouts/Base.astro';
import PatternBand from '../components/PatternBand.astro';
import WaveTop from '../components/WaveTop.astro';
import site from '../content/site.json';
import Field from '../components/Field.astro';
import logoRaw from '../assets/walife-logo.svg?raw';
import { url } from '../lib/url';
import { routes, t, loc, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const base = logoRaw.replace(/<style>[\s\S]*?<\/style>/, '').replace(/<defs>\s*<\/defs>/, '').replace(/class="cls-1"/g, '');
const dp = [...base.matchAll(/<path[^>]* d="([^"]+)"/g)].map((m) => m[1]);
// ombreggiatura: tratteggio a 43° sul lato destro/basso, come le colline
const logoSvg = base.replace('</svg>', `<defs><pattern id="hh" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(43)"><line x1="0" y1="0" x2="0" y2="9" stroke="#1a1a1a" stroke-width="1.4"/></pattern><clipPath id="hs"><polygon points="150,0 269,0 269,414 105,414"/></clipPath></defs><g clip-path="url(#hs)" class="shade">${dp.map((d) => `<path d="${d}" fill="url(#hh)" stroke="none"/>`).join('')}</g></svg>`);
const all = site.PROJECTS as any[];
const featured = all.slice(0, 4);
// due righe di anteprime che scorrono in senso opposto con lo scroll
const row1 = [...all.slice(0, 6), ...all.slice(0, 6)];
const row2 = [...all.slice(6), ...all.slice(6), ...all.slice(6)];
const services = [1, 2, 3, 4].map((n) => ({ t: t(lang, `s${n}t`), p: t(lang, `s${n}p`) }));
const email = site.SOCIALS.find((s) => s.name === 'Email')!;
const about = `${t(lang, 'abBio')} ${t(lang, 'abBio2')}`;
---
<Base lang={lang} page="home" home title={t(lang, 'docTitle')} description={t(lang, 'docDesc')}>
  <section class="hero on-green" id="hero" data-hero>
    <Field class="hero-field" name="meadow-hero" layers={3} w={1600} h={300} eager />
    <div class="wrap hero-grid">
      <h1 class="hero-h" data-lang={lang}>{t(lang, 'heroH')}</h1>
      <p class="hero-sub label">{t(lang, 'eyebrow')} · {t(lang, 'abF2')}</p>
      <div class="hero-logo" aria-hidden="true" set:html={logoSvg} />
      <div class="hero-bar">
        <p class="lead">{t(lang, 'tagline')}</p>
        <a class="btn" href={url(routes.archive[lang])} data-snd>{t(lang, 'open')}</a>
      </div>
    </div>
  </section>

  <section class="strip" aria-hidden="true">
    <div class="strip-row" data-strip="1">{row1.map((p) => <img src={url(p.img)} alt="" width="420" height="270" loading="lazy" decoding="async" />)}</div>
    <div class="strip-row" data-strip="-1">{row2.map((p) => <img src={url(p.img)} alt="" width="420" height="270" loading="lazy" decoding="async" />)}</div>
  </section>

  <section class="about" id="about">
    <div class="wrap about-wrap">
      <h2 data-split>{t(lang, 'aboutTitle')}</h2>
      <p class="scrub" data-scrub>{about}</p>
      <a class="btn" href={url(routes.about[lang])} data-snd>{t(lang, 'ctaProject')}</a>
    </div>
  </section>

  <section class="services on-green has-wave" id="services">
    <WaveTop v={2} />
    <div class="wrap">
      <h2 data-split>{t(lang, 'svcTitle')}</h2>
      <ol class="svc-list">
        {services.map((s, i) => (
          <li class="svc-row rv" tabindex="0" data-snd>
            <span class="n">0{i + 1}</span>
            <div><h3>{s.t}</h3><p>{s.p}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="projects" id="work">
    <div class="wrap">
      <h2 data-split>{t(lang, 'projectsTitle')}</h2>
    </div>
    <div class="stack wrap" data-stack>
      {featured.map((p, i) => (
        <div class="stack-slot">
          <a class="pcard" data-pcard={i} href={`https://thawalife.com/p/${p.slug}.html`} target="_blank" rel="noopener" data-cursor="OPEN" data-snd style={`--top:${i * 28}px`}>
            <div class="pc-text">
              <span class="n">0{i + 1}</span>
              <span class="tags">{p.tags[lang]} · {String(p.date).slice(0, 4)}</span>
              <h3>{loc(p.title, lang)}</h3>
              <p>{p.desc[lang]}</p>
              <span class="go">{t(lang, 'openProject')}</span>
            </div>
            <div class="pc-img"><img src={url(p.img)} alt={`${loc(p.title, lang)}, ${p.tags[lang]}`} width="900" height="900" loading={i < 1 ? 'eager' : 'lazy'} decoding="async" /></div>
          </a>
        </div>
      ))}
    </div>
    <div class="wrap more"><a class="btn" href={url(routes.archive[lang])} data-snd>{t(lang, 'menuAll')}</a></div>
  </section>

  <PatternBand />

  <section class="arch" id="archive-cta">
    <div class="wrap">
      <span class="label">{t(lang, 'arIdx')}</span>
      <h2 data-split set:html={t(lang, 'arTitle')} />
      <p>{t(lang, 'arCopy')}</p>
    </div>
  </section>

  <section class="contact on-green has-wave" id="contact">
    <WaveTop v={3} />
    <div class="wrap contact-big">
      <span class="label rv">{t(lang, 'ctIdx')}</span>
      <h2 data-split>{t(lang, 'ctLead')} <em>{t(lang, 'ctLink')}</em></h2>
      <a class="mail" href={email.url} data-cursor="MAIL">{email.handle}</a>
      <ul class="socials rv">
        {(site.SOCIALS as any[]).filter((s) => s.name !== 'Email').map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener" data-snd><span class="label">{s.name} ↗</span><span class="h">{s.handle}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
  <script>
    import '../scripts/home';
  </script>
</Base>

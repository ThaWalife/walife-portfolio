---
import Base from '../layouts/Base.astro';
import site from '../content/site.json';
import pages from '../content/pages.json';
import { url } from '../lib/url';
import { routes, t, loc, projectPath, type Lang } from '../lib/i18n';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const all = site.PROJECTS as any[];
const idx = all.findIndex((p) => p.slug === slug);
const p = all[idx];
const content = (pages as Record<string, any>)[slug] ?? { links: [], blocks: [] };
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const title = loc(p.title, lang);
const cats = (p.cats as string[]).map((c) => (site.CATEGORIES as any)[c][lang]).join(' · ');
const paths = { it: projectPath(slug, 'it'), en: projectPath(slug, 'en') };
const ig = (id: string) => `https://www.instagram.com/p/${id}/`;
---
<Base lang={lang} page="archive" paths={paths} title={`${title} | Walife`} description={p.desc[lang]}>
  <section class="inner pj">
    <div class="wrap">
      <a class="btn back" href={url(routes.archive[lang])} data-snd>{t(lang, 'pgBack')}</a>
      <p class="label pj-idx">{t(lang, 'pgIdx').replace('{n}', String(idx + 1)).replace('{t}', String(all.length))}</p>
      <h1 class="pj-title" data-split>{title}</h1>
    </div>

    <div class="wrap">
      <aside class="pj-meta">
        <dl>
          <div><dt class="label">{t(lang, 'pgYear')}</dt><dd>{String(p.date).slice(0, 4)}</dd></div>
          <div><dt class="label">{t(lang, 'pgCats')}</dt><dd>{cats}</dd></div>
          {content.links.length > 0 && (
            <div><dt class="label">{t(lang, 'pgLinks')}</dt>
              <dd>{content.links.map((l: any) => <a class="pj-link" href={l.url} target="_blank" rel="noopener">{l[lang]} ↗</a>)}</dd>
            </div>
          )}
        </dl>
      </aside>
    </div>

    <div class="wrap pj-main">
      <div class="pj-body">
        <figure class="pj-cover"><img src={url(p.img)} alt={`${title}, ${p.tags[lang]}`} width="800" height="600" fetchpriority="high" decoding="async" /></figure>
        {content.blocks.map((b: any) => {
          if (b.type === 'p') return <p class="pj-p">{b[lang]}</p>;
          if (b.type === 'h') return <h2 class="pj-h">{b[lang]}</h2>;
          if (b.type === 'quote') return <blockquote class="pj-q">{b[lang]}</blockquote>;
          if (b.type === 'label') return <p class="label pj-label">{b[lang]}</p>;
          if (b.type === 'cta') return <a class="btn pj-cta" href={b.url} target="_blank" rel="noopener" data-snd>{b[lang]} ↗</a>;
          if (b.type === 'gallery')
            return <ul class="pj-gal" data-cols={b.cols ?? (b.items.length === 1 ? 1 : b.items[0].w >= b.items[0].h ? 2 : 3)}>{b.items.map((i: any, k: number) => (
              <li><button type="button" class="pj-zoom" data-zoom={url(i.src)} aria-label={`${title} ${k + 1}`}><img src={url(i.src)} alt={`${title}, ${k + 1}`} width={i.w} height={i.h} loading="lazy" decoding="async" style={`aspect-ratio:${i.w} / ${i.h}`} /></button></li>
            ))}</ul>;
          if (b.type === 'slider')
            return <ul class="pj-slider">{b.items.map((i: any, k: number) => (
              <li><button type="button" class="pj-zoom" data-zoom={url(i.src)} aria-label={`${title} ${k + 1}`}><img src={url(i.src)} alt={`${title}, ${k + 1}`} width={i.w} height={i.h} loading="lazy" decoding="async" /></button></li>
            ))}</ul>;
          if (b.type === 'book')
            return <div class="pj-book" data-book>
              <ul class="pj-book-track"><li class="pj-spacer" aria-hidden="true"></li>{b.pages.map((i: any, k: number) => (
                <li><button type="button" class="pj-zoom" data-zoom={url(i.src)} aria-label={`${t(lang, 'pgPage')} ${k + 1} ${t(lang, 'pgOf')} ${b.pages.length}`}><img src={url(i.src)} alt={`${title}, ${t(lang, 'pgPage')} ${k + 1} ${t(lang, 'pgOf')} ${b.pages.length}`} width={i.w} height={i.h} loading={k < 4 ? 'eager' : 'lazy'} decoding="async" /></button></li>
              ))}</ul>
              <div class="pj-book-nav">
                <button class="btn" type="button" data-book-prev aria-label={t(lang, 'pgBookPrev')}><span aria-hidden="true">←</span><span class="txt">{t(lang, 'pgBookPrev')}</span></button>
                <span class="label" data-book-count>1 / {b.pages.length}</span>
                <button class="btn" type="button" data-book-next aria-label={t(lang, 'pgBookNext')}><span class="txt">{t(lang, 'pgBookNext')}</span><span aria-hidden="true">→</span></button>
              </div>
            </div>;
          if (b.type === 'video')
            return <video class="pj-video" controls playsinline preload="none" poster={url(b.poster)} width={b.w} height={b.h} loop={b.loop} style={`aspect-ratio:${b.w} / ${b.h}`}><source src={url(b.src)} type="video/mp4" /></video>;
          if (b.type === 'youtube') return <div class="pj-yt"><img src={url(`img/yt/${b.id}.jpg`)} alt="" width="1280" height="720" loading="lazy" decoding="async" /><button class="btn pj-play" type="button" data-yt={b.id} aria-label={`${t(lang, 'pgPlay')} (YouTube)`}>▶ {t(lang, 'pgPlay')}</button></div>;
          if (b.type === 'ytgrid')
            return <ul class="pj-ytgrid">{b.items.map((i: any) => <li><div class="pj-yt"><img src={url(`img/yt/${i.id}.jpg`)} alt="" width="1280" height="720" loading="lazy" decoding="async" /><button class="btn pj-play" type="button" data-yt={i.id} aria-label={`${t(lang, 'pgPlay')}: ${i.title}`}>▶</button></div><p>{i.title}</p></li>)}</ul>;
          if (b.type === 'instagram')
            return <div class="pj-ig">{b.ids.map((id: string, k: number) => <a class="btn" href={ig(id)} target="_blank" rel="noopener" data-snd>{t(lang, 'openIG')} {k + 1} ↗</a>)}</div>;
          return null;
        })}
      </div>
    </div>

    <nav class="wrap pj-nav" aria-label="Progetti">
      <a class="pj-pn" href={url(projectPath(prev.slug, lang))} data-snd><span class="label">← {t(lang, 'pgPrev')}</span><strong>{loc(prev.title, lang)}</strong></a>
      <a class="pj-pn r" href={url(projectPath(next.slug, lang))} data-snd><span class="label">{t(lang, 'pgNext')} →</span><strong>{loc(next.title, lang)}</strong></a>
    </nav>
  </section>

  <dialog class="pj-dlg" data-dlg aria-label={title}>
    <div class="pj-dlg-bar">
      <div class="pj-dlg-zoom" role="group" aria-label={t(lang, 'zoomLabel')}>
        <button class="btn" type="button" data-zoom-out aria-label={t(lang, 'zoomOut')}>−</button>
        <button class="btn" type="button" data-zoom-reset aria-label={t(lang, 'zoomReset')}><span data-zoom-level>100%</span></button>
        <button class="btn" type="button" data-zoom-in aria-label={t(lang, 'zoomIn')}>+</button>
      </div>
      <button class="btn" type="button" data-dlg-close>{t(lang, 'pgClose')}</button>
    </div>
    <div class="pj-stage" data-stage><img alt="" data-dlg-img draggable="false" /></div>
    <div class="pj-dlg-nav">
      <button class="btn" type="button" data-dlg-prev aria-label={t(lang, 'pgPrevImg')}>←</button>
      <button class="btn" type="button" data-dlg-next aria-label={t(lang, 'pgNextImg')}>→</button>
    </div>
  </dialog>
  <script>
    import '../scripts/project';
  </script>
</Base>

---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const it = lang === 'it';
const blocks = it
  ? [
      ['Cookie e dati', 'Questo sito non usa cookie, strumenti di analisi né pubblicità. Nel tuo browser salva soltanto la lingua scelta e, se lo attivi, la preferenza del suono. Restano sul tuo dispositivo.'],
      ['Hosting', 'Il sito è ospitato su GitHub Pages. GitHub può registrare dati tecnici di accesso, come l’indirizzo IP, secondo la propria informativa.'],
      ['Link esterni', 'I link verso thawalife.com, Discord, TikTok e Bluesky portano a servizi esterni, con le loro regole.'],
      ['Contenuti', 'Grafiche, loghi e progetti presentati sono opera di Federico. I marchi dei clienti appartengono ai rispettivi proprietari. Non copiare o riutilizzare senza permesso.'],
      ['Contatti', 'Per richieste su dati o contenuti: thawalife@gmail.com.'],
    ]
  : [
      ['Cookies and data', 'This site uses no cookies, analytics or ads. Your browser only stores the language you picked and, if you turn it on, the sound preference. Both stay on your device.'],
      ['Hosting', 'The site is hosted on GitHub Pages. GitHub may log technical access data, such as the IP address, under its own policy.'],
      ['External links', 'Links to thawalife.com, Discord, TikTok and Bluesky lead to external services with their own rules.'],
      ['Content', 'The graphics, logos and projects shown are the work of Federico. Client trademarks belong to their owners. Do not copy or reuse without permission.'],
      ['Contact', 'For requests about data or content: thawalife@gmail.com.'],
    ];
---
<Base lang={lang} page="privacy" title={t(lang, 'privacy') + ' | Walife'} description={blocks[0][1]}>
  <section class="inner">
    <div class="wrap about-hero">
      <h1 style="font-size:clamp(44px,8vw,120px)">{t(lang, 'privacy')}</h1>
      <dl class="legal-list">
        {blocks.map(([h, p]) => (<div><dt class="label">{h}</dt><dd>{p}</dd></div>))}
      </dl>
    </div>
  </section>
</Base>

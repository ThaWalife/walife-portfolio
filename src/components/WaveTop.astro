---
// Prato inciso lungo il bordo superiore di una sezione verde: il prato "sale" dentro la sezione precedente.
import Field from './Field.astro';
interface Props { v?: 2 | 3 }
const { v = 2 } = Astro.props;
---
<Field class="field-top" name={v === 3 ? 'meadow-edge-b' : 'meadow-edge-a'} layers={2} w={1600} h={v === 3 ? 310 : 290} />
